{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "Übersetzung: Sarah Hickey\nLektorat: Angelika Lueckert Leon"
    } ]
  }, {
    "tStartMs": 13240,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "Vor ein paar Jahren,\nbrach ich in mein eigenes Haus ein."
    } ]
  }, {
    "tStartMs": 16460,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "Ich war gerade nach Hause gefahren,"
    } ]
  }, {
    "tStartMs": 18126,
    "dDurationMs": 2574,
    "segs": [ {
      "utf8": "es war um Mitternacht,\nmitten im Montrealer Winter,"
    } ]
  }, {
    "tStartMs": 20700,
    "dDurationMs": 2926,
    "segs": [ {
      "utf8": "ich hatte meinen Freund Jeff\nam anderen Ende der Stadt besucht"
    } ]
  }, {
    "tStartMs": 23626,
    "dDurationMs": 4150,
    "segs": [ {
      "utf8": "und das Thermometer\nauf meiner Veranda zeigte -40 ° an --"
    } ]
  }, {
    "tStartMs": 27800,
    "dDurationMs": 3106,
    "segs": [ {
      "utf8": "und fragen Sie mich nicht,\nob Celsius oder Fahrenheit,"
    } ]
  }, {
    "tStartMs": 30920,
    "dDurationMs": 2456,
    "segs": [ {
      "utf8": "bei -40 ° treffen sich \ndie beiden Skalen --"
    } ]
  }, {
    "tStartMs": 33400,
    "dDurationMs": 1256,
    "segs": [ {
      "utf8": "es war sehr kalt."
    } ]
  }, {
    "tStartMs": 34680,
    "dDurationMs": 3216,
    "segs": [ {
      "utf8": "Als ich auf der Veranda stand\nund in meinen Taschen kramte,"
    } ]
  }, {
    "tStartMs": 37920,
    "dDurationMs": 2256,
    "segs": [ {
      "utf8": "merkte ich, dass meine Schlüssel fehlten."
    } ]
  }, {
    "tStartMs": 40200,
    "dDurationMs": 2096,
    "segs": [ {
      "utf8": "Ich konnte sie durch das Fenster sehen,"
    } ]
  }, {
    "tStartMs": 42320,
    "dDurationMs": 3096,
    "segs": [ {
      "utf8": "sie lagen da auf dem Esstisch,\nwo ich sie zurückgelassen hatte."
    } ]
  }, {
    "tStartMs": 45440,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "Ich rannte ums Haus und probierte\nalle anderen Türen und Fenster,"
    } ]
  }, {
    "tStartMs": 48600,
    "dDurationMs": 1576,
    "segs": [ {
      "utf8": "die fest verschlossen waren."
    } ]
  }, {
    "tStartMs": 50200,
    "dDurationMs": 3143,
    "segs": [ {
      "utf8": "Ich überlegte einen Schlosser anzurufen,\nich hatte ja mein Handy,"
    } ]
  }, {
    "tStartMs": 53367,
    "dDurationMs": 3329,
    "segs": [ {
      "utf8": "aber um Mitternacht könnte es dauern,\nbis ein Schlosser kommt,"
    } ]
  }, {
    "tStartMs": 56720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "und es war kalt."
    } ]
  }, {
    "tStartMs": 60421,
    "dDurationMs": 2715,
    "segs": [ {
      "utf8": "Ich konnte nicht bei meinem \nFreund Jeff übernachten,"
    } ]
  }, {
    "tStartMs": 63160,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "weil ich am Morgen einen frühen Flug\nnach Europa hatte"
    } ]
  }, {
    "tStartMs": 65851,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "und meinen Reisepass und Koffer brauchte."
    } ]
  }, {
    "tStartMs": 68400,
    "dDurationMs": 2496,
    "segs": [ {
      "utf8": "Verzweifelt und verfroren"
    } ]
  }, {
    "tStartMs": 70920,
    "dDurationMs": 3616,
    "segs": [ {
      "utf8": "fand ich einen großen Stein\nund zerbrach damit das Kellerfenster,"
    } ]
  }, {
    "tStartMs": 74560,
    "dDurationMs": 1976,
    "segs": [ {
      "utf8": "räumte die Glasscherben beiseite,"
    } ]
  }, {
    "tStartMs": 76560,
    "dDurationMs": 1336,
    "segs": [ {
      "utf8": "kletterte hinein,"
    } ]
  }, {
    "tStartMs": 77920,
    "dDurationMs": 3416,
    "segs": [ {
      "utf8": "fand ein Stück Pappe\nund klebte es über das Loch,"
    } ]
  }, {
    "tStartMs": 81360,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "mit dem Gedanken, am Morgen,\nauf dem Weg zum Flughafen,"
    } ]
  }, {
    "tStartMs": 84004,
    "dDurationMs": 2772,
    "segs": [ {
      "utf8": "meinen Bauleiter anzurufen,\nmit der Bitte es zu reparieren."
    } ]
  }, {
    "tStartMs": 86800,
    "dDurationMs": 1477,
    "segs": [ {
      "utf8": "Das würde viel kosten,"
    } ]
  }, {
    "tStartMs": 88301,
    "dDurationMs": 3555,
    "segs": [ {
      "utf8": "aber vermutlich nicht mehr, \nals ein Schlosser mitten in der Nacht,"
    } ]
  }, {
    "tStartMs": 91880,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "also dachte ich mir, unter diesen \nUmständen kommt es auf dasselbe raus."
    } ]
  }, {
    "tStartMs": 96920,
    "dDurationMs": 2176,
    "segs": [ {
      "utf8": "Ich bin ein gelernter Neurowissenschaftler"
    } ]
  }, {
    "tStartMs": 99120,
    "dDurationMs": 4096,
    "segs": [ {
      "utf8": "und weiß ein wenig darüber\nwie sich das Gehirn bei Stress verhält."
    } ]
  }, {
    "tStartMs": 103240,
    "dDurationMs": 3536,
    "segs": [ {
      "utf8": "Es schüttet Cortisol aus,\nwas den Herzschlag erhöht,"
    } ]
  }, {
    "tStartMs": 106800,
    "dDurationMs": 2256,
    "segs": [ {
      "utf8": "es stimmt den Adrenalinlevel darauf ab"
    } ]
  }, {
    "tStartMs": 109080,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "und vernebelt die Denkfähigkeit."
    } ]
  }, {
    "tStartMs": 111080,
    "dDurationMs": 1976,
    "segs": [ {
      "utf8": "Am nächsten Morgen,"
    } ]
  }, {
    "tStartMs": 113080,
    "dDurationMs": 2456,
    "segs": [ {
      "utf8": "hatte ich zu wenig geschlafen"
    } ]
  }, {
    "tStartMs": 115560,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "und machte mir Sorgen\num das Loch im Fenster,"
    } ]
  }, {
    "tStartMs": 118320,
    "dDurationMs": 2776,
    "segs": [ {
      "utf8": "ich musste daran denken,\nmeinen Bauunternehmer anzurufen"
    } ]
  }, {
    "tStartMs": 121120,
    "dDurationMs": 1696,
    "segs": [ {
      "utf8": "und bei den eisigen Temperaturen"
    } ]
  }, {
    "tStartMs": 122840,
    "dDurationMs": 2456,
    "segs": [ {
      "utf8": "und den bevorstehenden Meetings in Europa"
    } ]
  }, {
    "tStartMs": 125320,
    "dDurationMs": 3536,
    "segs": [ {
      "utf8": "mit all dem Cortisol in meinem Gehirn,"
    } ]
  }, {
    "tStartMs": 128880,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "war mein Denken vernebelt,"
    } ]
  }, {
    "tStartMs": 130280,
    "dDurationMs": 3416,
    "segs": [ {
      "utf8": "nur wusste ich das nicht, weil\nmeine Gedanken eben vernebelt waren."
    } ]
  }, {
    "tStartMs": 133720,
    "dDurationMs": 1496,
    "segs": [ {
      "utf8": "(Lachen)"
    } ]
  }, {
    "tStartMs": 135240,
    "dDurationMs": 3256,
    "segs": [ {
      "utf8": "Erst als ich am Check-In-Schalter\nam Flughafen stand,"
    } ]
  }, {
    "tStartMs": 138520,
    "dDurationMs": 2256,
    "segs": [ {
      "utf8": "merkte ich, dass mein Pass fehlte."
    } ]
  }, {
    "tStartMs": 140800,
    "dDurationMs": 2016,
    "segs": [ {
      "utf8": "(Lachen)"
    } ]
  }, {
    "tStartMs": 142840,
    "dDurationMs": 3456,
    "segs": [ {
      "utf8": "Also raste ich in 40 Minuten\ndurch Schnee und Eis nach Hause,"
    } ]
  }, {
    "tStartMs": 146320,
    "dDurationMs": 2456,
    "segs": [ {
      "utf8": "holte meinen Pass\nund raste zurück zum Flughafen,"
    } ]
  }, {
    "tStartMs": 148800,
    "dDurationMs": 1816,
    "segs": [ {
      "utf8": "ich habe es so eben geschafft,"
    } ]
  }, {
    "tStartMs": 150640,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "aber mein Platz war schon vergeben worden,"
    } ]
  }, {
    "tStartMs": 152903,
    "dDurationMs": 2976,
    "segs": [ {
      "utf8": "wodurch ich am Ende des Flugzeugs\nneben den Toiletten landete,"
    } ]
  }, {
    "tStartMs": 155903,
    "dDurationMs": 3217,
    "segs": [ {
      "utf8": "in einem nicht verstellbaren Sitz,\nbei einem achtstündigen Flug."
    } ]
  }, {
    "tStartMs": 159880,
    "dDurationMs": 3456,
    "segs": [ {
      "utf8": "Ich hatte viel Zeit zum Nachdenken\nin diesen acht Stunden ohne Schlaf."
    } ]
  }, {
    "tStartMs": 163360,
    "dDurationMs": 1136,
    "segs": [ {
      "utf8": "(Lachen)"
    } ]
  }, {
    "tStartMs": 164520,
    "dDurationMs": 2656,
    "segs": [ {
      "utf8": "Und ich fragte mich, ob es\nDinge gibt, die ich tun kann,"
    } ]
  }, {
    "tStartMs": 167200,
    "dDurationMs": 1936,
    "segs": [ {
      "utf8": "Mechanismen, die ich einführen kann,"
    } ]
  }, {
    "tStartMs": 169160,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "die das Eintreffen schlechter Dinge\nverhindern können?"
    } ]
  }, {
    "tStartMs": 171696,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Oder die wenigstens, wenn etwas passiert,"
    } ]
  }, {
    "tStartMs": 173856,
    "dDurationMs": 4704,
    "segs": [ {
      "utf8": "die Wahrscheinlichkeit reduzieren,\ndass es eine totale Katastrophe wird."
    } ]
  }, {
    "tStartMs": 179360,
    "dDurationMs": 1576,
    "segs": [ {
      "utf8": "Also dachte ich darüber nach,"
    } ]
  }, {
    "tStartMs": 180950,
    "dDurationMs": 2898,
    "segs": [ {
      "utf8": "aber meine Gedanken gewannen\nerst einen Monat später Form."
    } ]
  }, {
    "tStartMs": 183848,
    "dDurationMs": 3688,
    "segs": [ {
      "utf8": "Ich war beim Essen mit meinem Kollegen\nDanny Kahneman, dem Nobelpreisträger,"
    } ]
  }, {
    "tStartMs": 187560,
    "dDurationMs": 3376,
    "segs": [ {
      "utf8": "und erzählte ihm leicht beschämt\nvon meinem eingeschlagenen Fenster"
    } ]
  }, {
    "tStartMs": 190960,
    "dDurationMs": 2416,
    "segs": [ {
      "utf8": "und dem vergessenen Pass"
    } ]
  }, {
    "tStartMs": 193400,
    "dDurationMs": 1216,
    "segs": [ {
      "utf8": "und Danny erzählte mir,"
    } ]
  }, {
    "tStartMs": 194640,
    "dDurationMs": 4496,
    "segs": [ {
      "utf8": "er habe etwas namens\nvorausschauender Rückblick trainiert."
    } ]
  }, {
    "tStartMs": 199160,
    "dDurationMs": 1736,
    "segs": [ {
      "utf8": "(Lachen)"
    } ]
  }, {
    "tStartMs": 200920,
    "dDurationMs": 3143,
    "segs": [ {
      "utf8": "Er hatte es vom Psychologen\nGary Klein gelernt,"
    } ]
  }, {
    "tStartMs": 204087,
    "dDurationMs": 2289,
    "segs": [ {
      "utf8": "der vor einigen Jahren\ndarüber geschrieben hatte,"
    } ]
  }, {
    "tStartMs": 206376,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "auch Pre-Mortem genannt."
    } ]
  }, {
    "tStartMs": 208280,
    "dDurationMs": 1907,
    "segs": [ {
      "utf8": "Sie wissen alle was das Post-Mortem ist."
    } ]
  }, {
    "tStartMs": 210187,
    "dDurationMs": 1549,
    "segs": [ {
      "utf8": "Immer wenn es ein Disaster gibt,"
    } ]
  }, {
    "tStartMs": 211760,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "kommt ein Expertenteam und versucht \nherauszufinden was schief lief, richtig?"
    } ]
  }, {
    "tStartMs": 216080,
    "dDurationMs": 2416,
    "segs": [ {
      "utf8": "Beim Premortem, wie Danny erklärte,"
    } ]
  }, {
    "tStartMs": 218520,
    "dDurationMs": 3896,
    "segs": [ {
      "utf8": "schaut man voraus, um herauszufinden,\nwas alles schief gehen könnte"
    } ]
  }, {
    "tStartMs": 222440,
    "dDurationMs": 2576,
    "segs": [ {
      "utf8": "und dann versucht man herauszufinden,\nwas man tun kann,"
    } ]
  }, {
    "tStartMs": 225040,
    "dDurationMs": 3496,
    "segs": [ {
      "utf8": "damit diese Dinge nicht eintreffen,\noder um den Schaden zu minimieren."
    } ]
  }, {
    "tStartMs": 228560,
    "dDurationMs": 2936,
    "segs": [ {
      "utf8": "Worüber ich heute sprechen möchte,"
    } ]
  }, {
    "tStartMs": 231520,
    "dDurationMs": 3536,
    "segs": [ {
      "utf8": "sind ein paar Dinge, die wir \nin Form eines Pre-Mortems tun können."
    } ]
  }, {
    "tStartMs": 235080,
    "dDurationMs": 2896,
    "segs": [ {
      "utf8": "Manche von ihnen sind offensichtlich,\nandere sind es nicht."
    } ]
  }, {
    "tStartMs": 238000,
    "dDurationMs": 1936,
    "segs": [ {
      "utf8": "Ich fange mit den Offensichtlichen an."
    } ]
  }, {
    "tStartMs": 239960,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "Bestimmen Sie zu Hause einen Ort\nfür Dinge, die man leicht verliert."
    } ]
  }, {
    "tStartMs": 245680,
    "dDurationMs": 3856,
    "segs": [ {
      "utf8": "Das hört sich ganz logisch an\nund ist es auch,"
    } ]
  }, {
    "tStartMs": 249560,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "aber es steckt eine Menge\nWissenschaft dahinter,"
    } ]
  }, {
    "tStartMs": 252120,
    "dDurationMs": 3296,
    "segs": [ {
      "utf8": "die darauf basiert wie unser\nräumliches Gedächtnis funktioniert."
    } ]
  }, {
    "tStartMs": 255440,
    "dDurationMs": 2856,
    "segs": [ {
      "utf8": "Ein Bestandteil des Gehirns,\nder Hippocampus heißt,"
    } ]
  }, {
    "tStartMs": 258320,
    "dDurationMs": 2936,
    "segs": [ {
      "utf8": "hat sich über zehntausende\nJahre entwickelt,"
    } ]
  }, {
    "tStartMs": 261280,
    "dDurationMs": 3776,
    "segs": [ {
      "utf8": "um nachzuverfolgen wo\nwichtige Dingen abgelegt wurden --"
    } ]
  }, {
    "tStartMs": 265080,
    "dDurationMs": 2416,
    "segs": [ {
      "utf8": "wo der Brunnen ist,\nwo man Fisch finden kann,"
    } ]
  }, {
    "tStartMs": 267520,
    "dDurationMs": 2496,
    "segs": [ {
      "utf8": "die Stelle mit den Obstbäumen,"
    } ]
  }, {
    "tStartMs": 270040,
    "dDurationMs": 2616,
    "segs": [ {
      "utf8": "wo die befreundeten und \ndie verfeindeten Stämme leben."
    } ]
  }, {
    "tStartMs": 272680,
    "dDurationMs": 1965,
    "segs": [ {
      "utf8": "Der Hippocampus ist der Teil des Gehirns,"
    } ]
  }, {
    "tStartMs": 274645,
    "dDurationMs": 3451,
    "segs": [ {
      "utf8": "der sich bei Taxifahrern \nin London vergrößert."
    } ]
  }, {
    "tStartMs": 278120,
    "dDurationMs": 3706,
    "segs": [ {
      "utf8": "Es ist der Teil des Gehirns, der es \nEichhörnchen erlaubt ihre Nüsse zu finden."
    } ]
  }, {
    "tStartMs": 281840,
    "dDurationMs": 2858,
    "segs": [ {
      "utf8": "Und falls Sie sich fragen,\njemand hat das Experiment gemacht,"
    } ]
  }, {
    "tStartMs": 284722,
    "dDurationMs": 2774,
    "segs": [ {
      "utf8": "wobei der Geruchssinn der Eichhörnchen\nausgeschaltet wurde"
    } ]
  }, {
    "tStartMs": 287520,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "und sie trotzdem ihre Nüsse fanden."
    } ]
  }, {
    "tStartMs": 289360,
    "dDurationMs": 2816,
    "segs": [ {
      "utf8": "Sie benutzten nicht Geruch,\nsondern den Hippocampus,"
    } ]
  }, {
    "tStartMs": 292200,
    "dDurationMs": 5016,
    "segs": [ {
      "utf8": "diesen äußerst entwickelten Mechanismus\nim Gehirn, um Dinge zu finden."
    } ]
  }, {
    "tStartMs": 297240,
    "dDurationMs": 3736,
    "segs": [ {
      "utf8": "Das ist wirklich gut für Dinge, \ndie sich nicht viel bewegen,"
    } ]
  }, {
    "tStartMs": 301000,
    "dDurationMs": 2456,
    "segs": [ {
      "utf8": "aber nicht so gut für Dinge, \ndie sich bewegen."
    } ]
  }, {
    "tStartMs": 303480,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "Darum verlieren wir Autoschlüssel,\nLesebrillen und Reisepässe."
    } ]
  }, {
    "tStartMs": 307800,
    "dDurationMs": 2496,
    "segs": [ {
      "utf8": "Bestimmen Sie im Haus einen Ort\nfür Ihre Schlüssel --"
    } ]
  }, {
    "tStartMs": 310320,
    "dDurationMs": 2856,
    "segs": [ {
      "utf8": "einen Haken neben der Tür,\nvielleicht eine schöne Schale."
    } ]
  }, {
    "tStartMs": 313200,
    "dDurationMs": 2096,
    "segs": [ {
      "utf8": "Für Ihren Pass, eine bestimmte Schublade."
    } ]
  }, {
    "tStartMs": 315320,
    "dDurationMs": 2776,
    "segs": [ {
      "utf8": "Für Ihre Lesebrille,\neinen bestimmten Tisch."
    } ]
  }, {
    "tStartMs": 318120,
    "dDurationMs": 3456,
    "segs": [ {
      "utf8": "Wenn Sie einen bestimmten Ort festlegen\nund sich daran halten,"
    } ]
  }, {
    "tStartMs": 321600,
    "dDurationMs": 2816,
    "segs": [ {
      "utf8": "werden Ihre Dinge immer da sein,\nwenn Sie nach ihnen suchen."
    } ]
  }, {
    "tStartMs": 324440,
    "dDurationMs": 1216,
    "segs": [ {
      "utf8": "Was ist mit Reisen?"
    } ]
  }, {
    "tStartMs": 325680,
    "dDurationMs": 2376,
    "segs": [ {
      "utf8": "Machen Sie ein Handyfoto\nvon Ihren Kreditkarten,"
    } ]
  }, {
    "tStartMs": 328080,
    "dDurationMs": 2296,
    "segs": [ {
      "utf8": "Ihrem Führerschein, Ihrem Pass,"
    } ]
  }, {
    "tStartMs": 330400,
    "dDurationMs": 2296,
    "segs": [ {
      "utf8": "emailen Sie es sich,\ndamit es in der Cloud ist."
    } ]
  }, {
    "tStartMs": 332696,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "So können Sie Ersatz anfordern, wenn diese\nDinge verloren sind oder gestohlen werden."
    } ]
  }, {
    "tStartMs": 337080,
    "dDurationMs": 2616,
    "segs": [ {
      "utf8": "Dies sind recht offensichtliche Dinge."
    } ]
  }, {
    "tStartMs": 339720,
    "dDurationMs": 3536,
    "segs": [ {
      "utf8": "Vergessen Sie nicht, bei Stress\nschüttet das Gehirn Cortisol aus."
    } ]
  }, {
    "tStartMs": 343280,
    "dDurationMs": 3216,
    "segs": [ {
      "utf8": "Cortisol ist toxisch und \nverursacht unklares Denken."
    } ]
  }, {
    "tStartMs": 346520,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "Teil des Pre-Mortems ist es,"
    } ]
  }, {
    "tStartMs": 349080,
    "dDurationMs": 4256,
    "segs": [ {
      "utf8": "zu realisieren, dass man bei Stress nicht\nin seiner besten Form ist"
    } ]
  }, {
    "tStartMs": 353360,
    "dDurationMs": 2296,
    "segs": [ {
      "utf8": "und dafür Mechanismen vorbereiten sollte."
    } ]
  }, {
    "tStartMs": 355680,
    "dDurationMs": 2936,
    "segs": [ {
      "utf8": "Es gibt vermutlich keine\nstressigere Situation,"
    } ]
  }, {
    "tStartMs": 358640,
    "dDurationMs": 3416,
    "segs": [ {
      "utf8": "als die wenn man mit einer medizinischen\nEntscheidung konfrontiert ist."
    } ]
  }, {
    "tStartMs": 362080,
    "dDurationMs": 3296,
    "segs": [ {
      "utf8": "Irgendwann werden alle von uns \neinmal in der Situation sein,"
    } ]
  }, {
    "tStartMs": 365400,
    "dDurationMs": 2376,
    "segs": [ {
      "utf8": "eine sehr wichtige Entscheidung \ntreffen zu müssen"
    } ]
  }, {
    "tStartMs": 367800,
    "dDurationMs": 3496,
    "segs": [ {
      "utf8": "über die eigene medizinische Versorgung, \noder die einer geliebten Person,"
    } ]
  }, {
    "tStartMs": 371296,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "um dieser dabei zu helfen."
    } ]
  }, {
    "tStartMs": 372860,
    "dDurationMs": 1576,
    "segs": [ {
      "utf8": "Also möchte ich darüber sprechen."
    } ]
  }, {
    "tStartMs": 374440,
    "dDurationMs": 3016,
    "segs": [ {
      "utf8": "Ich werde über eine ganz bestimmtes\nKrankheitsbild sprechen."
    } ]
  }, {
    "tStartMs": 377480,
    "dDurationMs": 3536,
    "segs": [ {
      "utf8": "Aber dies wird als Beispiel für jegliche\nmedizinische Entscheidung stehen"
    } ]
  }, {
    "tStartMs": 381040,
    "dDurationMs": 4016,
    "segs": [ {
      "utf8": "und sogar für Entscheidungsfindung\nim Finanziellen und Sozialen --"
    } ]
  }, {
    "tStartMs": 385080,
    "dDurationMs": 2256,
    "segs": [ {
      "utf8": "jede Art von Entscheidungsfindung,"
    } ]
  }, {
    "tStartMs": 387360,
    "dDurationMs": 4016,
    "segs": [ {
      "utf8": "die von rationaler Begutachtung\nder Fakten profitieren könnte."
    } ]
  }, {
    "tStartMs": 391400,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "Angenommen Sie gehen\nzum Arzt und der sagt:"
    } ]
  }, {
    "tStartMs": 394560,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "\"Ich habe Ihre Ergebnisse vom Labor zurück\nund Ihr Cholesterin ist etwas erhöht.\""
    } ]
  }, {
    "tStartMs": 399240,
    "dDurationMs": 3016,
    "segs": [ {
      "utf8": "Nun wissen Sie alle, \ndass hohes Cholesterin"
    } ]
  }, {
    "tStartMs": 402280,
    "dDurationMs": 4136,
    "segs": [ {
      "utf8": "mit erhöhtem Risiko für kardiovaskuläre\nErkrankungen assoziiert wird,"
    } ]
  }, {
    "tStartMs": 406440,
    "dDurationMs": 1416,
    "segs": [ {
      "utf8": "Herzinfarkt, Schlaganfall."
    } ]
  }, {
    "tStartMs": 407880,
    "dDurationMs": 1216,
    "segs": [ {
      "utf8": "Daher denken Sie sich,"
    } ]
  }, {
    "tStartMs": 409120,
    "dDurationMs": 2096,
    "segs": [ {
      "utf8": "hohes Cholesterin ist nicht so gut"
    } ]
  }, {
    "tStartMs": 411240,
    "dDurationMs": 3016,
    "segs": [ {
      "utf8": "und ihr Arzt sagt:\n\"Ich würde Ihnen gerne etwas verschreiben,"
    } ]
  }, {
    "tStartMs": 414280,
    "dDurationMs": 2856,
    "segs": [ {
      "utf8": "das Ihnen helfen wird Ihr Cholesterin\nzu senken, ein Statin.\""
    } ]
  }, {
    "tStartMs": 417136,
    "dDurationMs": 1384,
    "segs": [ {
      "utf8": "Sie kennen Statine vermutlich"
    } ]
  }, {
    "tStartMs": 418520,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "und wissen, dass sie zu den \ngeläufigsten Medikamenten"
    } ]
  }, {
    "tStartMs": 421050,
    "dDurationMs": 962,
    "segs": [ {
      "utf8": "in der Welt gehören,"
    } ]
  }, {
    "tStartMs": 422012,
    "dDurationMs": 2143,
    "segs": [ {
      "utf8": "Sie kennen sicher sogar Leute,\ndie sie nehmen."
    } ]
  }, {
    "tStartMs": 424155,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "Daher denken Sie sich:\n\"Ja! Geben Sie mir das Statin.\""
    } ]
  }, {
    "tStartMs": 427321,
    "dDurationMs": 2655,
    "segs": [ {
      "utf8": "Aber an diesem Punkt sollten Sie\neine Frage stellen,"
    } ]
  }, {
    "tStartMs": 430000,
    "dDurationMs": 1906,
    "segs": [ {
      "utf8": "nach einer Statistik sollten Sie fragen,"
    } ]
  }, {
    "tStartMs": 431906,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "über die die meisten Ärzte \nnicht gerne sprechen"
    } ]
  }, {
    "tStartMs": 434360,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "und über die Pharmaunternehmen\nnoch weniger gerne sprechen."
    } ]
  }, {
    "tStartMs": 438800,
    "dDurationMs": 2376,
    "segs": [ {
      "utf8": "Über die Anzahl der \nnotwendigen Behandlungen."
    } ]
  }, {
    "tStartMs": 441200,
    "dDurationMs": 1976,
    "segs": [ {
      "utf8": "Was genau ist das?"
    } ]
  }, {
    "tStartMs": 443200,
    "dDurationMs": 3056,
    "segs": [ {
      "utf8": "Es ist die Anzahl der Personen,\ndie ein Medikament nehmen"
    } ]
  }, {
    "tStartMs": 446280,
    "dDurationMs": 2856,
    "segs": [ {
      "utf8": "oder eine Operation haben oder\nein Verfahren mitmachen müssen"
    } ]
  }, {
    "tStartMs": 449160,
    "dDurationMs": 2376,
    "segs": [ {
      "utf8": "bevor einer Person dadurch geholfen wird."
    } ]
  }, {
    "tStartMs": 451560,
    "dDurationMs": 2856,
    "segs": [ {
      "utf8": "Sie denken sich, was ist das für \neine verrückte Statistik?"
    } ]
  }, {
    "tStartMs": 454440,
    "dDurationMs": 1246,
    "segs": [ {
      "utf8": "Die Zahl sollte eins sein."
    } ]
  }, {
    "tStartMs": 455686,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "Mein Arzt würde mir nichts verschreiben,"
    } ]
  }, {
    "tStartMs": 457760,
    "dDurationMs": 1285,
    "segs": [ {
      "utf8": "wenn es nicht helfen wird."
    } ]
  }, {
    "tStartMs": 459069,
    "dDurationMs": 2484,
    "segs": [ {
      "utf8": "Doch die medizinische Praxis \nfunktioniert so nicht."
    } ]
  }, {
    "tStartMs": 461578,
    "dDurationMs": 1531,
    "segs": [ {
      "utf8": "Daran ist nicht der Arzt schuld,"
    } ]
  }, {
    "tStartMs": 463134,
    "dDurationMs": 2959,
    "segs": [ {
      "utf8": "wenn jemand schuld ist,\ndann Wissenschaftler wie ich."
    } ]
  }, {
    "tStartMs": 466093,
    "dDurationMs": 2859,
    "segs": [ {
      "utf8": "Wir haben die zugrunde liegenden\nMechanismen noch nicht raus."
    } ]
  }, {
    "tStartMs": 468966,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "GlaxoSmithKline schätzt,"
    } ]
  }, {
    "tStartMs": 471400,
    "dDurationMs": 4976,
    "segs": [ {
      "utf8": "dass 90 % aller Medikamente\nnur bei 30 bis 50 % der Leute wirken."
    } ]
  }, {
    "tStartMs": 476400,
    "dDurationMs": 3816,
    "segs": [ {
      "utf8": "Was denken Sie, ist die Anzahl\nder notwendigen Behandlungen"
    } ]
  }, {
    "tStartMs": 480240,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "für das am meisten verschriebene Statin?"
    } ]
  }, {
    "tStartMs": 482400,
    "dDurationMs": 2856,
    "segs": [ {
      "utf8": "Wieviele Personen müssen es nehmen,\nbevor einer geholfen ist?"
    } ]
  }, {
    "tStartMs": 485256,
    "dDurationMs": 1184,
    "segs": [ {
      "utf8": "300."
    } ]
  }, {
    "tStartMs": 487035,
    "dDurationMs": 1431,
    "segs": [ {
      "utf8": "Das ist ein Forschungsergebnis"
    } ]
  }, {
    "tStartMs": 488466,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "der Forscher Jerome Groopman\nund Pamela Hartzband,"
    } ]
  }, {
    "tStartMs": 492000,
    "dDurationMs": 2776,
    "segs": [ {
      "utf8": "unabhängig bestätigt von Bloomberg.com."
    } ]
  }, {
    "tStartMs": 494800,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Ich habe die Zahlen selber geprüft."
    } ]
  }, {
    "tStartMs": 497920,
    "dDurationMs": 2376,
    "segs": [ {
      "utf8": "300 Leute müssen das Medikament\nein Jahr einnehmen,"
    } ]
  }, {
    "tStartMs": 500320,
    "dDurationMs": 3976,
    "segs": [ {
      "utf8": "bevor ein Herzinfarkt, ein Schlaganfall\noder Ähnliches verhindert ist."
    } ]
  }, {
    "tStartMs": 504320,
    "dDurationMs": 1381,
    "segs": [ {
      "utf8": "Jetzt denken Sie vermutlich:"
    } ]
  }, {
    "tStartMs": 505725,
    "dDurationMs": 2811,
    "segs": [ {
      "utf8": "\"Okay, eine 1:300-Chance\nmein Cholesterin zu senken."
    } ]
  }, {
    "tStartMs": 508560,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": "Warum nicht? Geben Sie mir\ndas Rezept trotzdem.\""
    } ]
  }, {
    "tStartMs": 510800,
    "dDurationMs": 2856,
    "segs": [ {
      "utf8": "Aber hier sollten Sie nach \neiner anderen Statistik fragen"
    } ]
  }, {
    "tStartMs": 513680,
    "dDurationMs": 2576,
    "segs": [ {
      "utf8": "und zwar: \"Erzählen Sie mir\nvon den Nebenwirkungen.\""
    } ]
  }, {
    "tStartMs": 516280,
    "dDurationMs": 1656,
    "segs": [ {
      "utf8": "Für dieses bestimmte Medikament"
    } ]
  }, {
    "tStartMs": 517960,
    "dDurationMs": 3656,
    "segs": [ {
      "utf8": "treten Nebenwirkungen bei \nfünf Prozent der Patienten auf."
    } ]
  }, {
    "tStartMs": 521630,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "Und dazu gehören furchtbare Dinge --"
    } ]
  }, {
    "tStartMs": 523347,
    "dDurationMs": 4428,
    "segs": [ {
      "utf8": "Muskelschwäche, Gelenkschmerzen,\nMagen-Darm-Probleme --"
    } ]
  }, {
    "tStartMs": 527799,
    "dDurationMs": 1859,
    "segs": [ {
      "utf8": "aber nun denken Sie: \"Fünf Prozent,"
    } ]
  }, {
    "tStartMs": 529682,
    "dDurationMs": 1528,
    "segs": [ {
      "utf8": "vermutlich trifft es mich nicht,"
    } ]
  }, {
    "tStartMs": 531210,
    "dDurationMs": 1492,
    "segs": [ {
      "utf8": "ich nehme das Mittel trotzdem.\""
    } ]
  }, {
    "tStartMs": 532702,
    "dDurationMs": 1048,
    "segs": [ {
      "utf8": "Doch einen Augenblick."
    } ]
  }, {
    "tStartMs": 533750,
    "dDurationMs": 2530,
    "segs": [ {
      "utf8": "Erinnern Sie sich, unter Stress\ndenken Sie nicht klar."
    } ]
  }, {
    "tStartMs": 536280,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Überlegen Sie sich im Voraus\nwie Sie das durchdenken können,"
    } ]
  }, {
    "tStartMs": 539100,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "damit Sie die Argumentationskette\nnicht im Moment selbst aufstellen müssen."
    } ]
  }, {
    "tStartMs": 542633,
    "dDurationMs": 2832,
    "segs": [ {
      "utf8": "300 Personen nehmen das Mittel.\nEiner Person ist geholfen,"
    } ]
  }, {
    "tStartMs": 545489,
    "dDurationMs": 2407,
    "segs": [ {
      "utf8": "5 % von diesen 300 haben Nebenwirkungen,"
    } ]
  }, {
    "tStartMs": 547920,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "das sind 15 Personen."
    } ]
  }, {
    "tStartMs": 549800,
    "dDurationMs": 3896,
    "segs": [ {
      "utf8": "Es ist 15 Mal wahrscheinlicher,\ndass Ihnen das Mittel schadet,"
    } ]
  }, {
    "tStartMs": 553720,
    "dDurationMs": 2816,
    "segs": [ {
      "utf8": "als dass es Ihnen hilft."
    } ]
  }, {
    "tStartMs": 556550,
    "dDurationMs": 2915,
    "segs": [ {
      "utf8": "Ich sage nicht, ob Sie das Statin\nnehmen sollen oder nicht."
    } ]
  }, {
    "tStartMs": 559489,
    "dDurationMs": 2947,
    "segs": [ {
      "utf8": "Ich sage nur, dass Sie mit Ihrem Arzt\ndarüber sprechen sollten."
    } ]
  }, {
    "tStartMs": 562436,
    "dDurationMs": 1390,
    "segs": [ {
      "utf8": "Die Medizinethik verlangt es,"
    } ]
  }, {
    "tStartMs": 563826,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "es gehört zum Prinzip \nder informierten Einwilligung."
    } ]
  }, {
    "tStartMs": 566320,
    "dDurationMs": 3216,
    "segs": [ {
      "utf8": "Sie haben das Recht auf diese Information,"
    } ]
  }, {
    "tStartMs": 569560,
    "dDurationMs": 3896,
    "segs": [ {
      "utf8": "um zu entscheiden, ob Sie das Risiko\nin Kauf nehmen wollen oder nicht."
    } ]
  }, {
    "tStartMs": 573460,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Sie denken vielleicht"
    } ]
  }, {
    "tStartMs": 574660,
    "dDurationMs": 2756,
    "segs": [ {
      "utf8": "ich habe mir diese Zahl\nals Schockeffekt ausgedacht,"
    } ]
  }, {
    "tStartMs": 577440,
    "dDurationMs": 3256,
    "segs": [ {
      "utf8": "dabei ist dies eine übliche\nAnzahl notwendiger Behandlungen."
    } ]
  }, {
    "tStartMs": 580720,
    "dDurationMs": 4616,
    "segs": [ {
      "utf8": "Für die meist durchgeführte Operation\nan Männern über 50,"
    } ]
  }, {
    "tStartMs": 585360,
    "dDurationMs": 2216,
    "segs": [ {
      "utf8": "Entnahme der Prostata wegen Krebs,"
    } ]
  }, {
    "tStartMs": 587600,
    "dDurationMs": 2576,
    "segs": [ {
      "utf8": "ist die Anzahl\nnotwendiger Behandlungen 49."
    } ]
  }, {
    "tStartMs": 590200,
    "dDurationMs": 4176,
    "segs": [ {
      "utf8": "Richtig, 49 Operationen sind nötig,\nbevor einer Person geholfen ist."
    } ]
  }, {
    "tStartMs": 594400,
    "dDurationMs": 4656,
    "segs": [ {
      "utf8": "Und hier treten die Nebenwirkungen \nbei 50 % der Patienten auf."
    } ]
  }, {
    "tStartMs": 599080,
    "dDurationMs": 2856,
    "segs": [ {
      "utf8": "Dazu gehören Impotenz, Erektionsstörungen,"
    } ]
  }, {
    "tStartMs": 601960,
    "dDurationMs": 2776,
    "segs": [ {
      "utf8": "Harninkontinenz, Mastdarmriss,"
    } ]
  }, {
    "tStartMs": 604760,
    "dDurationMs": 1456,
    "segs": [ {
      "utf8": "Stuhlinkontinenz."
    } ]
  }, {
    "tStartMs": 606240,
    "dDurationMs": 3496,
    "segs": [ {
      "utf8": "Wenn sie einer der glücklichen\n50 % sind, auf die diese zutreffen,"
    } ]
  }, {
    "tStartMs": 609760,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "sie halten nur ein oder zwei Jahre an."
    } ]
  }, {
    "tStartMs": 612880,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "Die Idee beim Pre-Mortem ist es"
    } ]
  }, {
    "tStartMs": 615990,
    "dDurationMs": 3106,
    "segs": [ {
      "utf8": "vorab über die Fragen nachzudenken,\ndie Sie fragen könnten,"
    } ]
  }, {
    "tStartMs": 619096,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "um das Gespräch weiter zu bringen."
    } ]
  }, {
    "tStartMs": 621486,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Sie wollen das nicht im Moment\nselbst erarbeiten müssen."
    } ]
  }, {
    "tStartMs": 624600,
    "dDurationMs": 2896,
    "segs": [ {
      "utf8": "Und Sie sollten auch an Dinge\nwie Lebensqualität denken."
    } ]
  }, {
    "tStartMs": 627520,
    "dDurationMs": 1776,
    "segs": [ {
      "utf8": "Weil Sie oftmals die Wahl haben,"
    } ]
  }, {
    "tStartMs": 629320,
    "dDurationMs": 2296,
    "segs": [ {
      "utf8": "wollen Sie ein kürzeres,\nschmerzfreies Leben"
    } ]
  }, {
    "tStartMs": 631640,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "oder ein längeres Leben, dass gegen Ende\nsehr schmerzhaft sein könnte?"
    } ]
  }, {
    "tStartMs": 635310,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "Über sowas sollten Sie\njetzt reden und nachdenken,"
    } ]
  }, {
    "tStartMs": 637820,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "mit Ihrer Familie und mit Freunden."
    } ]
  }, {
    "tStartMs": 639500,
    "dDurationMs": 2716,
    "segs": [ {
      "utf8": "Sie werden sich vielleicht\nim Moment selbst umentschieden,"
    } ]
  }, {
    "tStartMs": 642240,
    "dDurationMs": 3056,
    "segs": [ {
      "utf8": "aber wenigstens sind Sie dann\nin dieser Denkweise geübt."
    } ]
  }, {
    "tStartMs": 645320,
    "dDurationMs": 4616,
    "segs": [ {
      "utf8": "Bei Stress schüttet\nunser Gehirn Cortisol aus"
    } ]
  }, {
    "tStartMs": 649960,
    "dDurationMs": 2426,
    "segs": [ {
      "utf8": "und eines der Dinge, \ndie dann passieren ist,"
    } ]
  }, {
    "tStartMs": 652386,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "dass jede Menge\nFunktionen runterfahren."
    } ]
  }, {
    "tStartMs": 654280,
    "dDurationMs": 1905,
    "segs": [ {
      "utf8": "Es gibt einen evolutionären Grund dafür."
    } ]
  }, {
    "tStartMs": 656209,
    "dDurationMs": 3407,
    "segs": [ {
      "utf8": "Konfrontiert mit einem Raubtier\nbrauchen Sie Ihr Verdauungssystem nicht,"
    } ]
  }, {
    "tStartMs": 659640,
    "dDurationMs": 2456,
    "segs": [ {
      "utf8": "oder Ihre Libido, oder Ihr Immunsystem,"
    } ]
  }, {
    "tStartMs": 662120,
    "dDurationMs": 3656,
    "segs": [ {
      "utf8": "denn wenn Ihr Körper\ndafür Stoffwechsel aufwendet,"
    } ]
  }, {
    "tStartMs": 665800,
    "dDurationMs": 1656,
    "segs": [ {
      "utf8": "und Sie nicht schnell reagieren,"
    } ]
  }, {
    "tStartMs": 667480,
    "dDurationMs": 3976,
    "segs": [ {
      "utf8": "werden Sie vielleicht zum Mittagessen\ndes Löwens und der Rest ist dann egal."
    } ]
  }, {
    "tStartMs": 671480,
    "dDurationMs": 1416,
    "segs": [ {
      "utf8": "Bedauerlicherweise"
    } ]
  }, {
    "tStartMs": 672920,
    "dDurationMs": 3616,
    "segs": [ {
      "utf8": "ist eines der Dinge, die während der \nStressphase den Bach hinuntergehen"
    } ]
  }, {
    "tStartMs": 676560,
    "dDurationMs": 1976,
    "segs": [ {
      "utf8": "das rationale, logische Denken,"
    } ]
  }, {
    "tStartMs": 678560,
    "dDurationMs": 3416,
    "segs": [ {
      "utf8": "wie Danny Kahneman und \nseine Kollegen gezeigt haben."
    } ]
  }, {
    "tStartMs": 682000,
    "dDurationMs": 3176,
    "segs": [ {
      "utf8": "Also müssen wir trainieren,"
    } ]
  }, {
    "tStartMs": 685200,
    "dDurationMs": 2256,
    "segs": [ {
      "utf8": "diese Art von Situationen \nim Voraus zu denken."
    } ]
  }, {
    "tStartMs": 687480,
    "dDurationMs": 6176,
    "segs": [ {
      "utf8": "Der wichtigste Punkt ist zu erkennen,\ndass wir alle fehlerhaft sind."
    } ]
  }, {
    "tStartMs": 693680,
    "dDurationMs": 2856,
    "segs": [ {
      "utf8": "Wir werden alle ab und an versagen."
    } ]
  }, {
    "tStartMs": 696560,
    "dDurationMs": 3616,
    "segs": [ {
      "utf8": "Es geht darum vorauszudenken\nwas für Fehler das sein könnten,"
    } ]
  }, {
    "tStartMs": 700200,
    "dDurationMs": 3896,
    "segs": [ {
      "utf8": "Mechanismen bereitzustellen,\ndie den Schaden minimieren helfen,"
    } ]
  }, {
    "tStartMs": 704120,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "oder die das Eintreffen der schlechten\nDinge von vornherein verhindern."
    } ]
  }, {
    "tStartMs": 708240,
    "dDurationMs": 2716,
    "segs": [ {
      "utf8": "Um auf die verschneite Nacht\nin Montreal zurückzukommen,"
    } ]
  }, {
    "tStartMs": 710960,
    "dDurationMs": 1736,
    "segs": [ {
      "utf8": "als ich von meiner Reise wiederkam,"
    } ]
  }, {
    "tStartMs": 712720,
    "dDurationMs": 3856,
    "segs": [ {
      "utf8": "bat ich meinen Bauleiter, mir \nein Zahlenschloss an der Tür einzubauen,"
    } ]
  }, {
    "tStartMs": 716600,
    "dDurationMs": 3536,
    "segs": [ {
      "utf8": "mit integriertem Haustürschlüssel\nmit einer einprägsamen Kombination."
    } ]
  }, {
    "tStartMs": 720160,
    "dDurationMs": 1216,
    "segs": [ {
      "utf8": "Und ich muss zugeben,"
    } ]
  }, {
    "tStartMs": 721400,
    "dDurationMs": 3416,
    "segs": [ {
      "utf8": "ich habe immer noch \neinen Haufen unsortierter Post"
    } ]
  }, {
    "tStartMs": 724840,
    "dDurationMs": 2616,
    "segs": [ {
      "utf8": "und jede Menge E-Mails,\ndie ich noch nicht gelesen habe."
    } ]
  }, {
    "tStartMs": 727456,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Ich bin nicht ganz durchorganisiert,"
    } ]
  }, {
    "tStartMs": 729240,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "aber ich sehe Organisation\nals einen schrittweisen Prozess"
    } ]
  }, {
    "tStartMs": 732400,
    "dDurationMs": 1216,
    "segs": [ {
      "utf8": "und ich bin auf dem Weg."
    } ]
  }, {
    "tStartMs": 733640,
    "dDurationMs": 1216,
    "segs": [ {
      "utf8": "Vielen Dank."
    } ]
  }, {
    "tStartMs": 734880,
    "dDurationMs": 4392,
    "segs": [ {
      "utf8": "(Applaus)"
    } ]
  } ]
}
