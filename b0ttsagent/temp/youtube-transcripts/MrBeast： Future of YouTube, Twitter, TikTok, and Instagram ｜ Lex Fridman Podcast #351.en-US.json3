  }, {
    "tStartMs": 5599800,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "But I don't know,"
    } ]
  }, {
    "tStartMs": 5601180,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I think that's just part of maturing it."
