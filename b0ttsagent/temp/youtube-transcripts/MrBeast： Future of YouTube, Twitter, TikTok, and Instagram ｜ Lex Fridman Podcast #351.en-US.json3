  }, {
    "tStartMs": 618853,
    "dDurationMs": 1097,
    "segs": [ {
      "utf8": "- I don't know, it's..."
    } ]
  }, {
    "tStartMs": 619950,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "I do recommend it."
    } ]
  }, {
    "tStartMs": 621300,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "The stoics meditate on death every day"
