    "segs": [ {
      "utf8": "'cause I had some concerns,"
    } ]
  }, {
    "tStartMs": 504827,
    "dDurationMs": 2863,
    "segs": [ {
      "utf8": "and I just thought it's\nalso a good exercise to do,"
    } ]
  }, {
    "tStartMs": 507690,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "a video to be released if I die,"
    } ]
  }, {
    "tStartMs": 510257,
    "dDurationMs": 3343,
    "segs": [ {
      "utf8": "and it was actually a\nreally interesting exercise."
    } ]
  }, {
    "tStartMs": 513600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It's cool, like it shows"
    } ]
  }, {
    "tStartMs": 514800,
    "dDurationMs": 1316,
    "segs": [ {
      "utf8": "what you really care about."
    } ]
  }, {
    "tStartMs": 516116,
    "dDurationMs": 1264,
    "segs": [ {
      "utf8": "I guess it's like writing a will."
    } ]
  }, {
    "tStartMs": 517380,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "But when you're younger,"
    } ]
  }, {
    "tStartMs": 518213,
    "dDurationMs": 1147,
    "segs": [ {
      "utf8": "you don't think about that kind of stuff"
    } ]
  }, {
    "tStartMs": 519360,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but--\n- Exactly, mine was just dumb."
