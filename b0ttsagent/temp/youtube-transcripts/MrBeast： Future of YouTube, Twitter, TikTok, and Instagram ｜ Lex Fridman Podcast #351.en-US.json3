  }, {
    "tStartMs": 5628930,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "these huge emotional reactions."
    } ]
  }, {
    "tStartMs": 5630370,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "It's like, that's why a lot of creators go"
