  }, {
    "tStartMs": 574380,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "The people that love you\nto kinda like celebrate."
    } ]
  }, {
    "tStartMs": 577170,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- Do you think that would\nhelp them cope or not?"
    } ]
  }, {
    "tStartMs": 579930,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "If someone randomly watching\nthis did film a video,"
