  }, {
    "tStartMs": 600510,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "Yeah, I guess."
    } ]
  }, {
    "tStartMs": 601620,
    "dDurationMs": 843,
    "segs": [ {
      "utf8": "- Yeah, and I guess you could say it"
    } ]
  }, {
    "tStartMs": 602463,
    "dDurationMs": 1857,
    "segs": [ {
      "utf8": "in a kind of funny way but..."
    } ]
  }, {
    "tStartMs": 604320,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And just talk about the things"
