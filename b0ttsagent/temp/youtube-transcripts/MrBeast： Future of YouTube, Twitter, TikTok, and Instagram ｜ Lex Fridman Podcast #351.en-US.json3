  }, {
    "tStartMs": 696373,
    "dDurationMs": 1575,
    "segs": [ {
      "utf8": "So it'd be really nice."
    } ]
  }, {
    "tStartMs": 697948,
    "dDurationMs": 2637,
    "segs": [ {
      "utf8": "It's almost absurd to think that,"
    } ]
  }, {
    "tStartMs": 700585,
    "dDurationMs": 2195,
    "segs": [ {
      "utf8": "in our lifetime, they\nwon't figure out a way"
