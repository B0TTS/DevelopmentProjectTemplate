  }, {
    "tStartMs": 5733060,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "that's what matters."
    } ]
  }, {
    "tStartMs": 5734200,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "- Okay, so that..."
    } ]
  }, {
    "tStartMs": 5736900,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "That's a good thing to define a success."
