  }, {
    "tStartMs": 5700930,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "on your sub-feed to watch a video?"
    } ]
  }, {
    "tStartMs": 5703000,
    "dDurationMs": 1730,
    "segs": [ {
      "utf8": "- Oh, almost never, yeah.\n- Yeah, maybe five years ago,"
    } ]
  }, {
    "tStartMs": 5704730,
    "dDurationMs": 1197,
    "segs": [ {
      "utf8": "it used to be a thing."
    } ]
  }, {
    "tStartMs": 5705927,
    "dDurationMs": 1633,
    "segs": [ {
      "utf8": "It's not anymore, no one does."
