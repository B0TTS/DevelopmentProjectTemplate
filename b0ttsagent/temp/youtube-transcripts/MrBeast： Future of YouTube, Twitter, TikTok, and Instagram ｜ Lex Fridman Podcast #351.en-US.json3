  }, {
    "tStartMs": 707520,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "they won't figure out somewhere"
    } ]
  }, {
    "tStartMs": 708353,
    "dDurationMs": 1147,
    "segs": [ {
      "utf8": "where we could live to be 200."
    } ]
  }, {
    "tStartMs": 709500,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Like, obviously not immortal,"
    } ]
  }, {
    "tStartMs": 710970,
    "dDurationMs": 2584,
    "segs": [ {
      "utf8": "but I don't see how, in my lifetime,"
