  }, {
    "tStartMs": 630180,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "it's talking to the world."
    } ]
  }, {
    "tStartMs": 631170,
    "dDurationMs": 2672,
    "segs": [ {
      "utf8": "And for some reason, at least for me,"
    } ]
  }, {
    "tStartMs": 633842,
    "dDurationMs": 2218,
    "segs": [ {
      "utf8": "that made it very concrete"
    } ]
  }, {
    "tStartMs": 636060,
    "dDurationMs": 1755,
    "segs": [ {
      "utf8": "that there's going to be an end,"
    } ]
  }, {
    "tStartMs": 637815,
    "dDurationMs": 2392,
    "segs": [ {
      "utf8": "and I'm like, \"It's almost..."
    } ]
  }, {
    "tStartMs": 640207,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "\"It's over for me."
    } ]
  }, {
    "tStartMs": 641137,
    "dDurationMs": 1493,
    "segs": [ {
      "utf8": "\"If I'm making the\nvideo, it's over for me.\""
    } ]
  }, {
    "tStartMs": 642630,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "It's an interesting thought experiment,"
    } ]
  }, {
    "tStartMs": 644070,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "I recommend people try it."
    } ]
  }, {
    "tStartMs": 647220,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Okay, are you afraid of death by the way?"
    } ]
  }, {
    "tStartMs": 651060,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- Yes."
    } ]
  }, {
    "tStartMs": 652847,
    "dDurationMs": 3643,
    "segs": [ {
      "utf8": "It's hard because, like,"
    } ]
  }, {
    "tStartMs": 656490,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "what if you just die"
    } ]
  }, {
    "tStartMs": 657420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and then you just see nothing forever?"
    } ]
  }, {
    "tStartMs": 659520,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Lex] Yeah, the nothingness."
    } ]
  }, {
    "tStartMs": 660353,
    "dDurationMs": 1027,
    "segs": [ {
      "utf8": "- It just fades to blackness"
    } ]
  }, {
    "tStartMs": 661380,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and you're just like that\nfor trillions upon trillions,"
    } ]
  }, {
    "tStartMs": 663600,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "to billion squared years, and it's just..."
