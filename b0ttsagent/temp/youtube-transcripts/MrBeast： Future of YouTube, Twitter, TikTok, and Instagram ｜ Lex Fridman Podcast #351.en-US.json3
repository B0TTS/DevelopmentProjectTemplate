  }, {
    "tStartMs": 671640,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "so that gives me a little comfort,"
    } ]
  }, {
    "tStartMs": 674250,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "but no, it's definitely very scary."
    } ]
  }, {
    "tStartMs": 676470,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "Something I'd rather not think about"
    } ]
  }, {
    "tStartMs": 677940,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "until I'm like 80."
    } ]
  }, {
    "tStartMs": 678780,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I'll deal with that problem then."
    } ]
  }, {
    "tStartMs": 680400,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "I don't know if I told you this,"
    } ]
  }, {
    "tStartMs": 682080,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "but I'm kind of hopeful\nthat someone like Elon,"
    } ]
  }, {
    "tStartMs": 684540,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "or one of these like freak smart people,"
