  }, {
    "tStartMs": 5637283,
    "dDurationMs": 2147,
    "segs": [ {
      "utf8": "because it really messes with you."
    } ]
  }, {
    "tStartMs": 5639430,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- We've talked about this a little bit,"
    } ]
  }, {
    "tStartMs": 5640690,
    "dDurationMs": 1454,
    "segs": [ {
      "utf8": "but how do you define"
