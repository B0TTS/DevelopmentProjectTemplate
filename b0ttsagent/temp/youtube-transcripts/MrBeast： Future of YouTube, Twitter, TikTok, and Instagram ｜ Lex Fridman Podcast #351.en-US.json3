    "segs": [ {
      "utf8": "so I have so much time."
    } ]
  }, {
    "tStartMs": 8124090,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I just hope whatever it is,"
    } ]
  }, {
    "tStartMs": 8125290,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that it's a net positive on the world"
    } ]
  }, {
    "tStartMs": 8127810,
    "dDurationMs": 2404,
    "segs": [ {
      "utf8": "and it impacts billions of people"
    } ]
  }, {
    "tStartMs": 8130214,
    "dDurationMs": 2077,
    "segs": [ {
      "utf8": "in a positive way"
    } ]
  }, {
    "tStartMs": 8132291,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "that makes lasting change."
    } ]
  }, {
    "tStartMs": 8135328,
    "dDurationMs": 3582,
    "segs": [ {
      "utf8": "- So you admire people like\nSteve Jobs and Elon Musk"
    } ]
  }, {
    "tStartMs": 8138910,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "for having reached for that goal as well?"
    } ]
  }, {
    "tStartMs": 8143080,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- [MrBeast] Yeah, of course."
    } ]
  }, {
    "tStartMs": 8144160,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "- To help millions.\n- I mean, the iPhone's"
    } ]
  }, {
    "tStartMs": 8146227,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "the most successful product ever invented."
    } ]
  }, {
    "tStartMs": 8147910,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "It's hard not to admire what he created,"
    } ]
  }, {
    "tStartMs": 8149980,
    "dDurationMs": 1137,
    "segs": [ {
      "utf8": "you know what I mean?"
    } ]
  }, {
    "tStartMs": 8151117,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "- And the same with sort of,"
    } ]
  }, {
    "tStartMs": 8152440,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "as Jony Ive talks about,"
    } ]
  }, {
    "tStartMs": 8155341,
    "dDurationMs": 1839,
    "segs": [ {
      "utf8": "the passion, the effort they put"
    } ]
  }, {
    "tStartMs": 8157180,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "into the designing the iPhone,"
    } ]
  }, {
    "tStartMs": 8159880,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "that like little bit\nof love is transferred"
    } ]
  }, {
    "tStartMs": 8161860,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "to the whole world."
    } ]
  }, {
    "tStartMs": 8162970,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "They get to experience the joy of that"
    } ]
  }, {
    "tStartMs": 8164410,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "from the designer."
    } ]
  }, {
    "tStartMs": 8165430,
    "dDurationMs": 1723,
    "segs": [ {
      "utf8": "- What a beautiful thing to\ndo, you know what I mean?"
    } ]
  }, {
    "tStartMs": 8167153,
    "dDurationMs": 2282,
    "segs": [ {
      "utf8": "I couldn't think of anything better."
    } ]
  }, {
    "tStartMs": 8169435,
    "dDurationMs": 1552,
    "segs": [ {
      "utf8": "To create something that,"
    } ]
  }, {
    "tStartMs": 8170987,
    "dDurationMs": 2003,
    "segs": [ {
      "utf8": "even after you're dead for decades,"
    } ]
  }, {
    "tStartMs": 8172990,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "just has such a profound impact"
    } ]
  }, {
    "tStartMs": 8175450,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "on basically half the human population."
    } ]
  }, {
    "tStartMs": 8177520,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "It's wild."
    } ]
  }, {
    "tStartMs": 8178540,
    "dDurationMs": 1464,
    "segs": [ {
      "utf8": "- Brings joy to people."
    } ]
  }, {
    "tStartMs": 8180004,
    "dDurationMs": 2076,
    "segs": [ {
      "utf8": "Well I hope you do just that, man."
    } ]
  }, {
    "tStartMs": 8182080,
    "dDurationMs": 1047,
    "segs": [ {
      "utf8": "You've already done it for millions,"
    } ]
  }, {
    "tStartMs": 8183127,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "and millions, and millions,\nand millions of people,"
    } ]
  }, {
    "tStartMs": 8185080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and I hope you keep doing it."
    } ]
  }, {
    "tStartMs": 8186760,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "I can't..."
    } ]
  }, {
    "tStartMs": 8188470,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "It's so exciting to see what happens"
    } ]
  }, {
    "tStartMs": 8190210,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "this year and next year."
    } ]
  }, {
    "tStartMs": 8191380,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- [MrBeast] I'm excited too.\n- The sky is the limit."
    } ]
  }, {
    "tStartMs": 8194350,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "I can't, I mean..."
    } ]
  }, {
    "tStartMs": 8196660,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "The videos, but all the\nother businesses you're in,"
    } ]
  }, {
    "tStartMs": 8199210,
    "dDurationMs": 1683,
    "segs": [ {
      "utf8": "and you, as a human being, as you grow,"
    } ]
  }, {
    "tStartMs": 8200893,
    "dDurationMs": 2577,
    "segs": [ {
      "utf8": "I can tell, I know, as everyone knows,"
    } ]
  }, {
    "tStartMs": 8203470,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "you have a kind heart,"
    } ]
  }, {
    "tStartMs": 8204520,
    "dDurationMs": 2107,
    "segs": [ {
      "utf8": "and the fact that you're really damn good"
    } ]
  }, {
    "tStartMs": 8206627,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "at actually using that kind of heart"
    } ]
  }, {
    "tStartMs": 8209710,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "to help a lot of people,"
    } ]
  }, {
    "tStartMs": 8211030,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "it's awesome to see, man.\n- Thank you."
    } ]
  }, {
    "tStartMs": 8212080,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I appreciate it."
    } ]
  }, {
    "tStartMs": 8212913,
    "dDurationMs": 1447,
    "segs": [ {
      "utf8": "More importantly, before we go,"
    } ]
  }, {
    "tStartMs": 8214360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "are we gonna play Dune tonight?"
    } ]
  }, {
    "tStartMs": 8216040,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "Some board games?\n- I'm not gonna play Dune."
    } ]
  }, {
    "tStartMs": 8217270,
    "dDurationMs": 1178,
    "segs": [ {
      "utf8": "I have to..."
    } ]
  }, {
    "tStartMs": 8218448,
    "dDurationMs": 903,
    "segs": [ {
      "utf8": "(speaking over each other)"
    } ]
  }, {
    "tStartMs": 8219351,
    "dDurationMs": 1429,
    "segs": [ {
      "utf8": "- You don't wanna play\nboard games with me?"
    } ]
  }, {
    "tStartMs": 8220780,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "- I wanna, I'll play..."
    } ]
  }, {
    "tStartMs": 8222330,
    "dDurationMs": 3335,
    "segs": [ {
      "utf8": "(speaking over each other)"
    } ]
  }, {
    "tStartMs": 8225665,
    "dDurationMs": 2158,
    "segs": [ {
      "utf8": "- If only I wasn't an idiot"
    } ]
  }, {
    "tStartMs": 8227823,
    "dDurationMs": 2466,
    "segs": [ {
      "utf8": "and actually flew to the right airport--"
    } ]
  }, {
    "tStartMs": 8230289,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "- If you don't board games with me,"
    } ]
  }, {
    "tStartMs": 8232030,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "they're gonna dislike the video."
    } ]
  }, {
    "tStartMs": 8235120,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "- Thanks for listening to this\nconversation with MrBeast."
    } ]
  }, {
    "tStartMs": 8238390,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "To support this podcast,"
    } ]
  }, {
    "tStartMs": 8239620,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "please check out our\nsponsors in the description."
    } ]
  }, {
    "tStartMs": 8242187,
    "dDurationMs": 2117,
    "segs": [ {
      "utf8": "And now, let me leave you with some words"
    } ]
  }, {
    "tStartMs": 8244304,
    "dDurationMs": 4169,
    "segs": [ {
      "utf8": "from the poet and philosopher,\nRabindranath Tagore,"
    } ]
  }, {
    "tStartMs": 8249317,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "\"Reach high, for stars lie hidden in you.\""
    } ]
  }, {
    "tStartMs": 8254470,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "Thank you for listening and\nhope to see you next time."
    } ]
  } ]
}
