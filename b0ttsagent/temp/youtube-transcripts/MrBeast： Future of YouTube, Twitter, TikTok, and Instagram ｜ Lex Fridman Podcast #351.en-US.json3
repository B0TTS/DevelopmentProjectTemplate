  }, {
    "tStartMs": 1008840,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "- I gotta get hired."
    } ]
  }, {
    "tStartMs": 1011263,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "- What do you think about\nvideo on the platform?"
