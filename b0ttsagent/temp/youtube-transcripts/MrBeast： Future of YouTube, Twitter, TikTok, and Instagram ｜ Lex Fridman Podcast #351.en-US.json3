  }, {
    "tStartMs": 5671500,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "more and more subscribers, kind of thing."
    } ]
  }, {
    "tStartMs": 5673630,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "- Yeah, but subscribers is\njust a vanity metric, you know?"
