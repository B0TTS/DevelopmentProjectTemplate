  }, {
    "tStartMs": 605700,
    "dDurationMs": 1323,
    "segs": [ {
      "utf8": "that mean a lot to you"
    } ]
  }, {
    "tStartMs": 607023,
    "dDurationMs": 2517,
    "segs": [ {
      "utf8": "because otherwise, you are at the risk"
