  }, {
    "tStartMs": 5596279,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "to the point where I'm\nalmost about to puke,"
    } ]
  }, {
    "tStartMs": 5598030,
    "dDurationMs": 1770,
    "segs": [ {
