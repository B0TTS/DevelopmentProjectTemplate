  }, {
    "tStartMs": 5397390,
    "dDurationMs": 935,
    "segs": [ {
      "utf8": "It's..."
    } ]
  }, {
    "tStartMs": 5398325,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "If a video does bad, I just look at it,"
