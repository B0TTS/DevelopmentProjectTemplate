  }, {
    "tStartMs": 5661753,
    "dDurationMs": 1407,
    "segs": [ {
      "utf8": "what your definition of success is?"
    } ]
  }, {
    "tStartMs": 5663160,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "'Cause I think a lot of creators don't"
