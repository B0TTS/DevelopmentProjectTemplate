  }, {
    "tStartMs": 5665770,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "really think, don't introspect."
    } ]
  }, {
    "tStartMs": 5670093,
    "dDurationMs": 1407,
    "segs": [ {
      "utf8": "They kind of wanna keep getting"
