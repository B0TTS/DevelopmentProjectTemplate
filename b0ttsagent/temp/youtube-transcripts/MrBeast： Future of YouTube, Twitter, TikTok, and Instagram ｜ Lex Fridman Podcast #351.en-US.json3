  }, {
    "tStartMs": 561160,
    "dDurationMs": 1816,
    "segs": [ {
      "utf8": "and a last Instagram post,"
    } ]
  }, {
    "tStartMs": 562976,
    "dDurationMs": 2674,
    "segs": [ {
      "utf8": "and yeah, it's..."
    } ]
  }, {
    "tStartMs": 565650,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "I feel like there's some aspect"
    } ]
  }, {
    "tStartMs": 567900,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "that's meditative to just\neven considering making"
    } ]
  }, {
    "tStartMs": 571410,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "a post like that."
    } ]
  }, {
    "tStartMs": 572340,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And also, it's a way for your..."
