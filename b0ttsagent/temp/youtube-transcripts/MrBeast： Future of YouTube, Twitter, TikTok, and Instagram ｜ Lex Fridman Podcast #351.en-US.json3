  }, {
    "tStartMs": 718170,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "the immortality is achieved\nin the digital realm."
    } ]
  }, {
    "tStartMs": 721560,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "It could be long be..."
    } ]
  }, {
    "tStartMs": 722820,
    "dDurationMs": 1307,
    "segs": [ {
      "utf8": "Long after you're gone,"
    } ]
  }, {
    "tStartMs": 724127,
    "dDurationMs": 1286,
    "segs": [ {
      "utf8": "there's a MrBeast run by"
    } ]
  }, {
    "tStartMs": 725413,
    "dDurationMs": 1817,
    "segs": [ {
      "utf8": "a ChatGPT type system.\n- Exactly."
    } ]
  }, {
    "tStartMs": 727230,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Yeah, that consumes\neverything I ever said,"
    } ]
  }, {
    "tStartMs": 728760,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "everything I ever wrote, and..."
    } ]
  }, {
    "tStartMs": 730240,
    "dDurationMs": 1364,
    "segs": [ {
      "utf8": "I don't want that, I wanna live."
    } ]
  }, {
    "tStartMs": 731604,
    "dDurationMs": 2256,
    "segs": [ {
      "utf8": "Why don't you smart people\nout there figure it out?"
