  } ],
  "events": [ {
    "tStartMs": 120,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "- I'm here with MrBeast,"
    } ]
  }, {
    "tStartMs": 1440,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "the brilliant mastermind behind"
    } ]
  }, {
    "tStartMs": 3660,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "some of the most popular\nvideos ever created."
    } ]
  }, {
    "tStartMs": 6630,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "Do you think you'll ever make a video"
    } ]
  }, {
    "tStartMs": 7800,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "that gets one billion views?"
    } ]
  }, {
    "tStartMs": 9540,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- I think maybe one of the videos"
    } ]
  }, {
    "tStartMs": 10980,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "we've already made might\nget a billion views."
    } ]
  }, {
    "tStartMs": 13560,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- Which one do you think?"
    } ]
  }, {
    "tStartMs": 14430,
    "dDurationMs": 2574,
    "segs": [ {
      "utf8": "- Probably the Squid Game\nvideo, with enough time."
    } ]
  }, {
    "tStartMs": 17004,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "I mean, it's only a year old"
    } ]
  }, {
    "tStartMs": 17837,
    "dDurationMs": 913,
    "segs": [ {
      "utf8": "and it's already on 300 million,"
    } ]
  }, {
    "tStartMs": 18750,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "or some of the newer ones"
    } ]
  }, {
    "tStartMs": 20340,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "we've done have gotten 100\nmillion views in a month."
    } ]
  }, {
    "tStartMs": 23700,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So those, forward projected over 10 years,"
    } ]
  }, {
    "tStartMs": 26220,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "'cause YouTube's not going anywhere,"
    } ]
  }, {
    "tStartMs": 27600,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "probably one of those."
    } ]
  }, {
    "tStartMs": 28433,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "- So over time, they\ndon't necessarily plateau?"
    } ]
  }, {
    "tStartMs": 30480,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "- What's interesting..."
    } ]
  }, {
    "tStartMs": 31350,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "We're literally jumping\nright into it, I love it."
    } ]
  }, {
    "tStartMs": 33090,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It's good."
    } ]
  }, {
    "tStartMs": 34290,
    "dDurationMs": 2415,
    "segs": [ {
      "utf8": "So I'm a firm believer that"
    } ]
  }, {
    "tStartMs": 36705,
    "dDurationMs": 3165,
    "segs": [ {
      "utf8": "it's much easier to hypothetically\nget 10 million views"
    } ]
  }, {
    "tStartMs": 39870,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "on one video than 100,000 on 100."
    } ]
  }, {
    "tStartMs": 42510,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And part of why it's much\neasier, in my opinion,"
    } ]
  }, {
    "tStartMs": 44250,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "is if you make a really good video,"
    } ]
  }, {
    "tStartMs": 45870,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "it's just so evergreen, and it never dies."
    } ]
  }, {
    "tStartMs": 47970,
    "dDurationMs": 936,
    "segs": [ {
      "utf8": "'Cause YouTube..."
    } ]
  }, {
    "tStartMs": 48906,
    "dDurationMs": 1614,
    "segs": [ {
      "utf8": "When you open up YouTube"
    } ]
  }, {
    "tStartMs": 50520,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and look at the videos,"
    } ]
  }, {
    "tStartMs": 51353,
    "dDurationMs": 1237,
    "segs": [ {
      "utf8": "they're just serving you whatever"
    } ]
  }, {
    "tStartMs": 52590,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "they think you'll like the best, you know?"
    } ]
  }, {
    "tStartMs": 54420,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And so if you just make a great video,"
    } ]
  }, {
    "tStartMs": 56310,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and it's constantly just"
    } ]
  }, {
    "tStartMs": 57660,
    "dDurationMs": 1684,
    "segs": [ {
      "utf8": "above every other video,"
    } ]
  }, {
    "tStartMs": 59344,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "even two years down the road,"
    } ]
  }, {
    "tStartMs": 61680,
    "dDurationMs": 987,
    "segs": [ {
      "utf8": "then they'll just keep serving it"
    } ]
  }, {
    "tStartMs": 62667,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "and never stop, you know?"
    } ]
  }, {
    "tStartMs": 64110,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Which is why it's much easier\nto make one great video"
    } ]
  }, {
    "tStartMs": 66090,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "than a bunch of mediocre ones."
    } ]
  }, {
    "tStartMs": 67650,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "- What about one billion subscribers?"
    } ]
  }, {
    "tStartMs": 70080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "You've passed PewDiePie as"
    } ]
  }, {
    "tStartMs": 71940,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "the most subscribed to YouTube channel."
    } ]
  }, {
    "tStartMs": 74400,
    "dDurationMs": 1775,
    "segs": [ {
      "utf8": "When do you think you get a billion?"
    } ]
  }, {
    "tStartMs": 76175,
    "dDurationMs": 1885,
    "segs": [ {
      "utf8": "- Let me do some math real quick."
    } ]
  }, {
    "tStartMs": 78060,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "So we're on 120.\n- So you think about this?"
    } ]
  }, {
    "tStartMs": 80850,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "- No, I don't, honestly,"
    } ]
  }, {
    "tStartMs": 81960,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "'Cause one thing you'll find,"
    } ]
  }, {
    "tStartMs": 84240,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "if you want to gain subscribers,"
    } ]
  }, {
    "tStartMs": 85650,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "if you want to give views,"
    } ]
  }, {
    "tStartMs": 86580,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "if you wanna make money,"
    } ]
  }, {
    "tStartMs": 87840,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "almost any metric in this\nvideo creation space,"
    } ]
  }, {
    "tStartMs": 90870,
    "dDurationMs": 2257,
    "segs": [ {
      "utf8": "if you want something,\nit all comes back to,"
    } ]
  }, {
    "tStartMs": 93127,
    "dDurationMs": 1703,
    "segs": [ {
      "utf8": "\"Okay, well then, just make great videos.\""
    } ]
  }, {
    "tStartMs": 94830,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So instead of like focusing on all"
    } ]
  }, {
    "tStartMs": 96690,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "these arbitrary vanity metrics,"
    } ]
  }, {
    "tStartMs": 98580,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "I just kind of focus on the one thing"
    } ]
  }, {
    "tStartMs": 99840,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "that gets me all that,"
    } ]
  }, {
    "tStartMs": 100980,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "which is make good videos."
    } ]
  }, {
    "tStartMs": 102210,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And I do think we will, one day,"
    } ]
  }, {
    "tStartMs": 104250,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "hit a billion subscribers."
    } ]
  }, {
    "tStartMs": 105083,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "I don't have a plan on going anywhere."
    } ]
  }, {
    "tStartMs": 106800,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Even though we're only\non 120 million right now"
    } ]
  }, {
    "tStartMs": 108840,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "on the main channel,"
    } ]
  }, {
    "tStartMs": 109920,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "I think like we're doing\naround 10 million a month now"
    } ]
  }, {
    "tStartMs": 112350,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "and YouTube just..."
    } ]
  }, {
    "tStartMs": 114420,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Yeah, I just don't see it going anywhere,"
    } ]
  }, {
    "tStartMs": 115980,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and I don't see any reason why"
    } ]
  }, {
    "tStartMs": 117450,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "I'd ever get burnt out or quit,"
    } ]
  }, {
    "tStartMs": 118650,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "so I think with enough time, yes."
    } ]
  }, {
    "tStartMs": 120870,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "- I wanted to ask you those\nfamily friendly questions"
    } ]
  }, {
    "tStartMs": 123240,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "before I go to the dark questions."
    } ]
  }, {
    "tStartMs": 124440,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So now--\n- Oh, we have dark questions!"
    } ]
  }, {
    "tStartMs": 126480,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Wait, no, but if you wanted to hook them,"
    } ]
  }, {
    "tStartMs": 128250,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "you would start off\nwith the dark questions."
    } ]
  }, {
    "tStartMs": 129840,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "That's how you get 'em."
    } ]
  }, {
    "tStartMs": 130680,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- Okay, well, let me ask you about the..."
    } ]
  }, {
    "tStartMs": 133230,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "A Twitter poll you posted,"
    } ]
  }, {
    "tStartMs": 134760,
    "dDurationMs": 2347,
    "segs": [ {
      "utf8": "a $10,000 death poll."
    } ]
  }, {
    "tStartMs": 137107,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "You tweeted, \"If someone\noffered you $10,000"
    } ]
  }, {
    "tStartMs": 140527,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "\"but if you take it a\nrandom person on earth dies,"
    } ]
  }, {
    "tStartMs": 143977,
    "dDurationMs": 2243,
    "segs": [ {
      "utf8": "\"would you take the $10,000?\""
    } ]
  }, {
    "tStartMs": 146220,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And 45% of people said yes."
    } ]
  }, {
    "tStartMs": 149190,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "That's, at least at the time I checked,"
    } ]
  }, {
    "tStartMs": 150990,
    "dDurationMs": 2677,
    "segs": [ {
      "utf8": "850,000 people committing murder"
    } ]
  }, {
    "tStartMs": 153667,
    "dDurationMs": 4583,
    "segs": [ {
      "utf8": "for just $8.5 billion in total."
    } ]
  }, {
    "tStartMs": 158250,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So what do you learn about\nhuman nature from that?"
    } ]
  }, {
    "tStartMs": 161130,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "- That's a good question."
    } ]
  }, {
    "tStartMs": 163920,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Honestly, this was late at night"
    } ]
  }, {
    "tStartMs": 165480,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "when I threw that up too."
    } ]
  }, {
    "tStartMs": 166313,
    "dDurationMs": 1447,
    "segs": [ {
      "utf8": "I was just like, \"Huh, this\nwill be a funny thing.\""
    } ]
  }, {
    "tStartMs": 167760,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "I assumed it'd be 90% no, and 10% yes."
    } ]
  }, {
    "tStartMs": 171150,
    "dDurationMs": 2151,
    "segs": [ {
      "utf8": "But there are a lot of serious people..."
    } ]
  }, {
    "tStartMs": 173301,
    "dDurationMs": 1149,
    "segs": [ {
      "utf8": "For you guys listening,"
    } ]
  }, {
    "tStartMs": 174450,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "I just did this random Twitter poll"
    } ]
  }, {
    "tStartMs": 176340,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "where I was like,"
    } ]
  }, {
    "tStartMs": 177173,
    "dDurationMs": 1274,
    "segs": [ {
      "utf8": "\"Would you take 10 grand"
    } ]
  }, {
    "tStartMs": 178447,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "\"if it meant someone\nrandom in the world died?\""
    } ]
  }, {
    "tStartMs": 180240,
    "dDurationMs": 2137,
    "segs": [ {
      "utf8": "And a lot of the replies\non the tweet were like,"
    } ]
  }, {
    "tStartMs": 182377,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "\"Hell yeah, why not?\""
    } ]
  }, {
    "tStartMs": 183357,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "And I was just not expecting that."
    } ]
  }, {
    "tStartMs": 185578,
    "dDurationMs": 2159,
    "segs": [ {
      "utf8": "And so, I don't really know."
    } ]
  }, {
    "tStartMs": 187737,
    "dDurationMs": 1893,
    "segs": [ {
      "utf8": "I mean, I feel like your take\nwould be better than mine."
    } ]
  }, {
    "tStartMs": 189630,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "- Was that disturbing to\nyou, surprising to you?"
    } ]
  }, {
    "tStartMs": 191610,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "- A little bit, yeah."
    } ]
  }, {
    "tStartMs": 192630,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "But obviously, a lot of\nthe people were trolling,"
    } ]
  }, {
    "tStartMs": 194880,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "but I actually..."
    } ]
  }, {
    "tStartMs": 195713,
    "dDurationMs": 1477,
    "segs": [ {
      "utf8": "When you read through those replies,"
    } ]
  }, {
    "tStartMs": 197190,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "I do think like 10% of\nthem were dead serious."
    } ]
  }, {
    "tStartMs": 200010,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "- Well, I think sometimes the trolling"
    } ]
  }, {
    "tStartMs": 201870,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and the LOLs reveal a thing"
    } ]
  }, {
    "tStartMs": 204630,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "we're too embarrassed to admit"
    } ]
  }, {
    "tStartMs": 206250,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "about the darker aspects of our nature."
    } ]
  }, {
    "tStartMs": 208350,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So I dunno if you listen"
    } ]
  }, {
    "tStartMs": 209550,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to Dan Carlin's \"Hardcore\nHistory\" podcast."
    } ]
  }, {
    "tStartMs": 211890,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "He has a episode on \"Painfotainment,\""
    } ]
  }, {
    "tStartMs": 215100,
    "dDurationMs": 2474,
    "segs": [ {
      "utf8": "which he describes throughout history"
    } ]
  }, {
    "tStartMs": 217574,
    "dDurationMs": 2056,
    "segs": [ {
      "utf8": "how humans have been really attracted"
    } ]
  }, {
    "tStartMs": 219630,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to watching the suffering of others."
    } ]
  }, {
    "tStartMs": 221610,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "So public executions,\nall that kind of stuff."
    } ]
  }, {
    "tStartMs": 225420,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And he believes that's in all of us,"
    } ]
  }, {
    "tStartMs": 227940,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "that, for example, if\nsomething like a YouTube,"
    } ]
  }, {
    "tStartMs": 230760,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "or a different platform,"
    } ]
  }, {
    "tStartMs": 232030,
    "dDurationMs": 2539,
    "segs": [ {
      "utf8": "streamed a public execution"
    } ]
  }, {
    "tStartMs": 234569,
    "dDurationMs": 3687,
    "segs": [ {
      "utf8": "or streamed a torture\nof another human being,"
    } ]
  }, {
    "tStartMs": 238256,
    "dDurationMs": 3664,
    "segs": [ {
      "utf8": "a lot of people would say\nthat's deeply unethical,"
    } ]
  }, {
    "tStartMs": 241920,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "but they will still tune in and watch."
    } ]
  }, {
    "tStartMs": 244260,
    "dDurationMs": 3145,
    "segs": [ {
      "utf8": "And that we're attracted to that drama,"
    } ]
  }, {
    "tStartMs": 247405,
    "dDurationMs": 1885,
    "segs": [ {
      "utf8": "and especially the most extreme versions"
    } ]
  }, {
    "tStartMs": 249290,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "of that drama."
    } ]
  }, {
    "tStartMs": 250380,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "And so I think part of\nthe LOLs reveals something"
    } ]
  }, {
    "tStartMs": 254130,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that's actually true in that poll."
    } ]
  }, {
    "tStartMs": 255960,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "That like--"
    } ]
  }, {
    "tStartMs": 256980,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- Your answer is so much better than mine."
    } ]
  }, {
    "tStartMs": 258720,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "- Do you think about that,"
    } ]
  }, {
    "tStartMs": 260555,
    "dDurationMs": 2275,
    "segs": [ {
      "utf8": "maybe even with the Squid Game?"
    } ]
  }, {
    "tStartMs": 262830,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Like, so I think..."
    } ]
  }, {
    "tStartMs": 264600,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "How many..."
    } ]
  }, {
    "tStartMs": 265560,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "How many views does"
    } ]
  }, {
    "tStartMs": 266393,
    "dDurationMs": 1687,
    "segs": [ {
      "utf8": "the Squid Game currently\nhave, 300 million?"
    } ]
  }, {
