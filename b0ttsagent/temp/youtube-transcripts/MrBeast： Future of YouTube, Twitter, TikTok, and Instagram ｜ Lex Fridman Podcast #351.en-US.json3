  }, {
    "tStartMs": 585090,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "to be given to their family,"
    } ]
  }, {
    "tStartMs": 586050,
    "dDurationMs": 837,
    "segs": [ {
      "utf8": "do you think that would..."
    } ]
  }, {
    "tStartMs": 586887,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "And it was like a genuine--"
    } ]
  }, {
    "tStartMs": 588510,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- I think it would really help."
    } ]
  }, {
    "tStartMs": 589650,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "I mean, it depends, because like--"
    } ]
  }, {
    "tStartMs": 590790,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "- Like, how would you even intro that?"
    } ]
  }, {
    "tStartMs": 592050,
    "dDurationMs": 2089,
    "segs": [ {
      "utf8": "Like, \"Hey mom, if you're seeing this,"
    } ]
  }, {
    "tStartMs": 594139,
    "dDurationMs": 1989,
    "segs": [ {
      "utf8": "\"it means I'm probably dead"
    } ]
  }, {
    "tStartMs": 596128,
    "dDurationMs": 1011,
    "segs": [ {
      "utf8": "\"and you're still alive.\"\n- Yeah, exactly."
    } ]
  }, {
    "tStartMs": 597139,
    "dDurationMs": 1015,
    "segs": [ {
      "utf8": "That's how you intro it."
    } ]
  }, {
    "tStartMs": 598154,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "That's the opener."
    } ]
  }, {
    "tStartMs": 598987,
    "dDurationMs": 1523,
    "segs": [ {
      "utf8": "- \"Oh, I just want you to know.\""
