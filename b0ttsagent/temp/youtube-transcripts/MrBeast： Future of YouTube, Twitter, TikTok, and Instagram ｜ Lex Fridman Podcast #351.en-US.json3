  }, {
    "tStartMs": 666750,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "It's scary."
    } ]
  }, {
    "tStartMs": 667830,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "But also, before you're born,"
    } ]
  }, {
    "tStartMs": 669210,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "you don't remember those\nX amount of years either"
