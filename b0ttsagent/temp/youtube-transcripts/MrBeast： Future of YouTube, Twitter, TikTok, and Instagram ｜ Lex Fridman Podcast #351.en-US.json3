  }, {
    "tStartMs": 686550,
    "dDurationMs": 997,
    "segs": [ {
      "utf8": "will just like be like, \"You know what?"
    } ]
  }, {
    "tStartMs": 687547,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "\"Screw it, I'm gonna\nfigure out a way where"
    } ]
  }, {
    "tStartMs": 689257,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "\"we can slow down aging."
    } ]
  }, {
    "tStartMs": 690757,
    "dDurationMs": 2393,
    "segs": [ {
      "utf8": "\"Get it where we can live\nto be 2-300 years old,\""
    } ]
  }, {
    "tStartMs": 693150,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "and just like set their sights on that,"
