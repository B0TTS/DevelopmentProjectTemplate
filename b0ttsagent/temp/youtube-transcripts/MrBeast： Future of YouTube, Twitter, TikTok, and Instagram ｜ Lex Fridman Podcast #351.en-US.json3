  }, {
    "tStartMs": 624810,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "and, in the same way,"
    } ]
  }, {
    "tStartMs": 625643,
    "dDurationMs": 1477,
    "segs": [ {
      "utf8": "you kind of meditate in your death"
