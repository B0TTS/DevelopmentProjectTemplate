  }, {
    "tStartMs": 713554,
    "dDurationMs": 2971,
    "segs": [ {
      "utf8": "the life expectancy doesn't just expand."
    } ]
  }, {
    "tStartMs": 716525,
    "dDurationMs": 1645,
    "segs": [ {
      "utf8": "- Well, it also could be that"
