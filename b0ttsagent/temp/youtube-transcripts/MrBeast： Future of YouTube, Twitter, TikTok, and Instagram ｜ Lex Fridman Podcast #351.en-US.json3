  }, {
    "tStartMs": 627120,
    "dDurationMs": 887,
    "segs": [ {
      "utf8": "when you make a video like that,"
    } ]
  }, {
    "tStartMs": 628007,
    "dDurationMs": 2173,
    "segs": [ {
      "utf8": "'cause it's actually not just\neven talking to yourself,"
