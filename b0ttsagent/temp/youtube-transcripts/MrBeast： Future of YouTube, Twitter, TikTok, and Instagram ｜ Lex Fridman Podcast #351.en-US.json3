  }, {
    "tStartMs": 7909929,
    "dDurationMs": 1304,
    "segs": [ {
      "utf8": "They're..."
    } ]
  }, {
    "tStartMs": 7911233,
    "dDurationMs": 3847,
    "segs": [ {
      "utf8": "James, the CEO who\nhelped me build all this,"
