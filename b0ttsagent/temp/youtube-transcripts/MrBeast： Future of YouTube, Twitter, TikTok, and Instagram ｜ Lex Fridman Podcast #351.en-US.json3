  }, {
    "tStartMs": 5799030,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "would be a better way of putting it."
    } ]
  }, {
    "tStartMs": 5801280,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "- Do you think you'll IPO MrBeast Burger"
