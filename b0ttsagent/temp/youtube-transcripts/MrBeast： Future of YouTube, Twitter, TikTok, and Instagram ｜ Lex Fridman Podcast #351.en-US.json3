    "dDurationMs": 1524,
    "segs": [ {
      "utf8": "at least in its current form."
    } ]
  }, {
    "tStartMs": 1025391,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I don't see 20 minute, one\nhour, long videos or whatever,"
