  }, {
    "tStartMs": 521580,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "I'm bones in a coffin.\n- Yeah."
    } ]
  }, {
    "tStartMs": 524220,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "- Yours is probably so serious."
    } ]
  }, {
    "tStartMs": 525870,
    "dDurationMs": 873,
    "segs": [ {
      "utf8": "- No, it's fun actually."
    } ]
  }, {
    "tStartMs": 526743,
    "dDurationMs": 1427,
    "segs": [ {
      "utf8": "What you realize it's\nlike there's no point"
    } ]
  }, {
    "tStartMs": 528170,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "to be serious at this point."
    } ]
  }, {
    "tStartMs": 529680,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "It's a weird thing..."
    } ]
  }, {
    "tStartMs": 531420,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "I guess you've done this,"
    } ]
  }, {
    "tStartMs": 532380,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "but it's a weird thing\nto address the world"
    } ]
  }, {
    "tStartMs": 534120,
    "dDurationMs": 850,
    "segs": [ {
      "utf8": "when you, the physical you,"
    } ]
  }, {
    "tStartMs": 534970,
    "dDurationMs": 1430,
    "segs": [ {
      "utf8": "is no longer there."
    } ]
  }, {
    "tStartMs": 536400,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So you know this would only be released"
    } ]
  }, {
    "tStartMs": 539100,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "if you're no longer there."
    } ]
  }, {
    "tStartMs": 540570,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "That's a weird exercise.\n- You know what's funny?"
    } ]
  }, {
    "tStartMs": 542190,
    "dDurationMs": 1672,
    "segs": [ {
      "utf8": "Of all the people listening to this,"
    } ]
  }, {
    "tStartMs": 543862,
    "dDurationMs": 1712,
    "segs": [ {
      "utf8": "we're probably the only two people"
    } ]
  }, {
    "tStartMs": 545574,
    "dDurationMs": 2976,
    "segs": [ {
      "utf8": "that have made videos for when we die."
    } ]
  }, {
    "tStartMs": 548550,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "It's like such a niche thing"
    } ]
  }, {
    "tStartMs": 549927,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "and the fact that we're bonding over it,"
    } ]
  }, {
    "tStartMs": 551550,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "it's kind of funny."
    } ]
  }, {
    "tStartMs": 552383,
    "dDurationMs": 1823,
    "segs": [ {
      "utf8": "- I think people should\nthink about doing that."
    } ]
  }, {
    "tStartMs": 554206,
    "dDurationMs": 974,
    "segs": [ {
      "utf8": "It's not just about YouTube,"
    } ]
  }, {
    "tStartMs": 555180,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "it's also social media,"
    } ]
  }, {
    "tStartMs": 556200,
    "dDurationMs": 1076,
    "segs": [ {
      "utf8": "'cause think about it."
    } ]
  }, {
    "tStartMs": 557276,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "There's gonna be a last tweet,"
