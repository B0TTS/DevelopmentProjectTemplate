  }, {
    "tStartMs": 5655952,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "piquing their curiosity."
    } ]
  }, {
    "tStartMs": 5657921,
    "dDurationMs": 2999,
    "segs": [ {
      "utf8": "For other people, it's\njust quitting their job."
    } ]
  }, {
    "tStartMs": 5660920,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- So you have to self-reflect on"
