                                    <a id="HC2BCD28C0A6C4BC8B558F25920EDCE98"> </a><span class="lbexSectionlevelOLC">SEC. 2106.</span><span class="lbexSectionlevelOLC"> <span class="lbexAllcap">Extension of authority to carry out certain fiscal year 2023 projects</span>.</span>
                                </div>
                            </a>
