                                            <td class="dot-leader" align="" valign="top" style="border-right: 2px  solid #C0C0C0; ; "><span class="td" style="padding-left:5px;padding-right:1px;">Japan</span></td><td class="dot-leader" align="left" valign="top" style="border-right: 2px  solid #C0C0C0; ; "><span class="td" style="padding-left:5px;padding-right:1px;"> Marine Corps Base Camp Smedley D. Butler</span></td><td class="" align="right" valign="bottom" style="border-right: 2px  solid #C0C0C0; ; "><span class="td" style="padding-left:5px;padding-right:1px;">$58,000,000</span></td>
