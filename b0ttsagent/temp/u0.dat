                                    <a id="HE55A42EB3E9446D3B34ABB710C997034"> </a><span class="lbexSectionlevelOLC">SEC. 2201.</span><span class="lbexSectionlevelOLC"> <span class="lbexAllcap">Authorized Navy construction and land acquisition projects</span>.</span>
                                </div>
                            </a>
                        </p>
                        <a id="HAE499FBE2AC1498D8CF018D96679DB32"> </a>
